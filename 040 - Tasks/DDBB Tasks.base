formulas:
  Count: file.backlinks.length
properties:
  file.backlinks:
    displayName: Task list
  formula.Count:
    displayName: Tasks
views:
  - type: cards
    name: All
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
    groupBy:
      property: priority
      direction: DESC
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: status
        direction: ASC
  - type: cards
    name: Status
    filters:
      and:
        - file.inFolder("040 - Tasks/status")
    order:
      - file.name
      - formula.Count
      - file.backlinks
    cardSize: 200
  - type: table
    name: ⚪ Undefined
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("00 - Undefined ⚪")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
    columnSize:
      file.name: 128
  - type: table
    name: 🔵 Defined
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("05 - Defined 🔵")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🔴 Blocked
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("06 - Blocked🔴")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🟣 In progress
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("10 - In progress 🟣")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🟡 Paused
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("11 - Paused 🟡")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🟢 Done
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status == link("15 - Done 🟢")
    order:
      - file.name
      - priority
      - status
      - proyectos
      - áreas
      - jornadas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: Undone
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - status != link("15 - Done 🟢")
    order:
      - file.name
      - status
      - projects
      - areas
    sort:
      - property: status
        direction: ASC
    columnSize:
      file.name: 271
  - type: cards
    name: Priorities
    filters:
      and:
        - file.inFolder("040 - Tasks/priority")
    order:
      - file.name
      - formula.Count
      - file.backlinks
    sort:
      - property: file.name
        direction: DESC
    cardSize: 180
  - type: table
    name: 🔥Critical
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - priority == link("20🔥Critical")
    order:
      - file.name
      - status
      - proyectos
      - áreas
      - jornadas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: ⚡️High
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - priority == link("15⚡️High")
    order:
      - file.name
      - status
      - proyectos
      - áreas
      - jornadas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🙂Default
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - priority == link("10🙂Default")
    order:
      - file.name
      - status
      - proyectos
      - áreas
      - jornadas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
  - type: table
    name: 🏖Low
    filters:
      and:
        - file.inFolder("040 - Tasks/items")
        - priority == link("05🏖Low")
    order:
      - file.name
      - status
      - proyectos
      - áreas
      - jornadas
    sort:
      - property: áreas
        direction: ASC
      - property: proyectos
        direction: ASC
